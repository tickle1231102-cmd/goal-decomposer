# Same as DATABASE_URL for Supabase (or use direct db host)
DIRECT_URL="postgresql://postgres.nnulpjepaearokjujbis:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

